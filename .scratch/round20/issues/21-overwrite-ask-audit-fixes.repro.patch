+/// Check 11 (c), global route: an Overwrite answer arrives after the folder
+/// in the way was moved aside; the deploy lands in an empty place and must
+/// not be recorded as overwritten.
+#[test]
+fn qm365_c11c_global_overwrite_into_an_emptied_place_is_not_overwritten() {
+    let dir = tempfile::tempdir().expect("tempdir");
+    let store = make_store(dir.path());
+    seed_skill(&store, "skill-1");
+    let source = make_skill_dir(dir.path(), "central-a", "# New A");
+    let root = dir.path().join("root");
+    let occupant = make_skill_dir(&root, "skill-a", "# Old A");
+    let skills = vec![batch_skill("skill-1", "skill-a", &source)];
+
+    let first = sync_skills_to_planned_tools(
+        &store,
+        &central_repo_of(&store),
+        &skills,
+        &[planned(claude(), &root, true)],
+        &BatchPolicy {
+            overwrite: false,
+            overwrite_if_same_content: true,
+            overrides: vec![],
+        },
+        1000,
+        |_| {},
+    );
+    assert!(matches!(
+        first[0].status,
+        BatchTargetStatus::Failed {
+            error: crate::core::errors::CommandError::TargetExists { .. }
+        }
+    ));
+    fs::rename(&occupant, root.join("moved-aside")).unwrap();
+
+    let retry = sync_skills_to_planned_tools(
+        &store,
+        &central_repo_of(&store),
+        &skills,
+        &[planned(claude(), &root, true)],
+        &BatchPolicy {
+            overwrite: false,
+            overwrite_if_same_content: true,
+            overrides: vec![BatchOverride {
+                skill_id: "skill-1".to_string(),
+                tool_key: "claude_code".to_string(),
+                decision: OverrideDecision::Overwrite,
+                path: Some(root.join("skill-a")),
+            }],
+        },
+        1100,
+        |_| {},
+    );
+
+    assert!(
+        matches!(retry[0].status, BatchTargetStatus::Synced { .. }),
+        "{:?}",
+        retry[0].status
+    );
+}
