+++ b/src/hooks/qm365.repro.test.ts
@@ -0,0 +1,164 @@
+// QM-365 reproduction tests (control lane), hook layer: what the recorded run
+// stores (`applyOutcome` → `recordRun` → `notifications`, the Notifications
+// panel's rows) and what the content view's document hands the view. Each
+// asserts the CORRECT behaviour, so it fails while the defect is present.
+import i18next from "i18next";
+import { act, cleanup, renderHook, waitFor } from "@testing-library/react";
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+
+vi.mock("sonner", () => ({
+  toast: { success: vi.fn(), error: vi.fn(), warning: vi.fn(), info: vi.fn(), dismiss: vi.fn() },
+}));
+vi.mock("../lib/tauri", () => ({ isTauri: true, invokeTauri: vi.fn() }));
+
+import type { BatchTargetOutcome, EnableReport, PropagationOutcome, RefreshReport } from "../bindings";
+import { resources } from "../i18n/resources";
+import { invokeTauri, type CommandName } from "../lib/tauri";
+import { globalCollisionRows, mergeGlobalRetry, mergeRefreshRetry, propagationCollisionRows } from "../lib/overwriteAsk";
+import { enableOutcome, refreshOutcome } from "../lib/reportOutcome";
+import { lineDiff } from "../lib/skillFiles";
+import { useSkillDocument } from "./useSkillDocument";
+import { useStatusReporter } from "./useStatusReporter";
+
+type T = (key: string, options?: Record<string, unknown>) => string;
+let t: T;
+beforeAll(async () => {
+  const i18n = i18next.createInstance();
+  await i18n.init({ resources, lng: "en", interpolation: { escapeValue: false } });
+  t = i18n.t.bind(i18n) as unknown as T;
+});
+afterEach(cleanup);
+
+const labels = { cursor: "Cursor", claude_code: "Claude Code" };
+const exists = (path: string) => ({
+  code: "TARGET_EXISTS" as const,
+  path,
+  modifiedAt: 1,
+  sameContent: false,
+  owner: { kind: "foreign" as const },
+});
+
+/** Every text the recorded run holds (titles and messages of its rows). */
+async function recorded(outcome: Parameters<ReturnType<typeof useStatusReporter>["applyOutcome"]>[0]) {
+  const { result } = renderHook(() => useStatusReporter(t as never));
+  await act(async () => {
+    await result.current.applyOutcome(outcome);
+  });
+  return result.current.notifications.map((row) => `${row.title}\n${row.message ?? ""}`).join("\n");
+}
+
+describe("check 4: the overwritten folder's line reaches the recorded run", () => {
+  it("(a) one skill's Update overwrites a deployment after Overwrite and hits an invocation Edit conflict", async () => {
+    const skill = { skillId: "s1", skillName: "alpha" };
+    const targets: PropagationOutcome[] = [
+      {
+        scope: { scope: "global", tool: "cursor" },
+        folder_key: "cursor",
+        status: { status: "failed", error: exists("/home/.cursor/skills/alpha"), first_deploy: true },
+      },
+    ];
+    const report: RefreshReport = {
+      skills: [
+        {
+          skill_id: "s1",
+          skill_name: "alpha",
+          status: {
+            status: "refreshed",
+            content_hash: null,
+            source_revision: null,
+            targets,
+            edit_conflict: { base_mode: "user-and-model", upstream_mode: "model-only", override_mode: "user-only" },
+          },
+        },
+      ],
+    };
+    // The ask's answer: Overwrite; `resolveTargetCollisions` settles the row overwritten.
+    const merged = mergeRefreshRetry(report, {
+      rows: propagationCollisionRows(skill, targets, labels),
+      global: [
+        {
+          skill_id: "s1",
+          skill_name: "alpha",
+          tool_key: "cursor",
+          folder_key: "cursor",
+          status: { status: "overwritten", outcome: { mode_used: "symlink", target_path: "/home/.cursor/skills/alpha", replaced: true } },
+        },
+      ],
+      projects: null,
+    });
+    expect(merged.overwritten).toHaveLength(1);
+    // As useSkillActions' refreshOne folds it.
+    const outcome = refreshOutcome(merged.report, {
+      t,
+      toolLabelById: labels,
+      single: { name: "alpha", success: "Updated alpha" },
+      declined: merged.declined,
+      overwritten: merged.overwritten,
+    });
+    expect(outcome.completion.conflict).toBe(true);
+    expect(await recorded(outcome)).toContain("/home/.cursor/skills/alpha");
+  });
+
+  it("(b) one Enable overwrites one target and leaves another collision unanswered", async () => {
+    const first: BatchTargetOutcome[] = ["cursor", "claude_code"].map((tool) => ({
+      skill_id: "s1",
+      skill_name: "alpha",
+      tool_key: tool,
+      folder_key: tool,
+      status: { status: "failed" as const, error: exists(`/home/.${tool}/skills/alpha`) },
+    }));
+    // Only Cursor's row is asked and answered Overwrite; Claude Code's stays a collision.
+    const asked = globalCollisionRows(first, labels).filter((row) => row.toolKey === "cursor");
+    const global = mergeGlobalRetry(first, asked, [
+      {
+        skill_id: "s1",
+        skill_name: "alpha",
+        tool_key: "cursor",
+        folder_key: "cursor",
+        status: { status: "overwritten", outcome: { mode_used: "symlink", target_path: "/home/.cursor/skills/alpha", replaced: true } },
+      },
+    ]);
+    const report: EnableReport = { global, projects: { items: [], skipped_projects: [] } };
+    const outcome = enableOutcome(report, { t, toolLabelById: labels });
+    expect(outcome.notes.join("\n")).toContain("/home/.cursor/skills/alpha");
+    expect(await recorded(outcome)).toContain("/home/.cursor/skills/alpha");
+  });
+});
+
+const mockInvoke = vi.mocked(
+  invokeTauri as unknown as (command: CommandName, ...args: unknown[]) => Promise<unknown>,
+);
+
+describe("check 2: the occupant listing's cap is disclosed", () => {
+  it("a truncated listing reaches the document the view renders", async () => {
+    mockInvoke.mockImplementation(async (command) => {
+      if (command === "listOccupantFiles")
+        return { entries: [{ path: "SKILL.md", size: 1, compared: "same" }], truncated: true };
+      if (command === "readOccupantFile") return { occupant: "x", skill: "x" };
+      throw new Error(`unexpected ${command}`);
+    });
+    const { result } = renderHook(() => useSkillDocument({ root: "/home/.cursor/skills/alpha", version: 0, comparedWith: "s1" }));
+    await waitFor(() => expect(result.current.loadingFiles).toBe(false));
+    // SkillFiles.tsx: `{doc.truncated ? <p …>{t("overwriteAsk.truncated")}</p> : null}`
+    expect(result.current.truncated).toBe(true);
+    expect(t("overwriteAsk.truncated")).toMatch(/first 500 files/);
+  });
+});
+
+describe("check 16: the document the content view diffs", () => {
+  it("a file missing in the folder and empty in the skill is not shown as the same", async () => {
+    mockInvoke.mockImplementation(async (command) => {
+      if (command === "listOccupantFiles")
+        return { entries: [{ path: "empty.md", size: 0, compared: "only_in_skill" }], truncated: false };
+      // Rust read_occupant_file: the side without the file is None.
+      if (command === "readOccupantFile") return { occupant: null, skill: "" };
+      throw new Error(`unexpected ${command}`);
+    });
+    const { result } = renderHook(() => useSkillDocument({ root: "/home/.cursor/skills/alpha", version: 0, comparedWith: "s1" }));
+    await waitFor(() => expect(result.current.loadingContent).toBe(false));
+    expect(result.current.activeFile).toBe("empty.md");
+    // SkillFiles.tsx: <FileDiff ours={doc.skillContent} theirs={doc.content} />, "same" when every line is.
+    const lines = lineDiff(result.current.skillContent, result.current.content);
+    expect(lines.every((line) => line.kind === "same")).toBe(false);
+  });
+});
