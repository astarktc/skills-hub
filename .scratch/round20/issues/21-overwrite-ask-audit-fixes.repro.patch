+            "skill side read as absent: {:?}",
+            file.occupant
+        ),
+    }
+    let listing = list_occupant_files(&occupant, Some(&skill)).unwrap();
+    assert_ne!(listing.entries[0].compared, FileComparison::Same);
+    assert_ne!(listing.entries[0].compared, FileComparison::OnlyHere);
+}
+
+/// Check 14 (b): the skill's version is not UTF-8.
+#[test]
+fn qm365_c14b_a_non_utf8_skill_file_is_not_read_as_absent() {
+    let tmp = tempfile::tempdir().unwrap();
+    let occupant = tmp.path().join("occupant");
+    let skill = tmp.path().join("skill");
+    write(&occupant, &[("SKILL.md", "theirs")]);
+    fs::create_dir_all(&skill).unwrap();
+    fs::write(skill.join("SKILL.md"), [0xff, 0xfe, 0x00, 0x80]).unwrap();
+
+    match read_occupant_file(&occupant, Some(&skill), "SKILL.md") {
+        Err(_) => {}
+        Ok(file) => assert!(file.skill.is_some(), "skill side read as absent"),
+    }
+}
+
+/// Check 14 (c): the skill's file listing fails (an unreadable folder in the
+/// Library copy): the listing must not report the occupant's files as
+/// "only in this folder".
+#[cfg(unix)]
+#[test]
+fn qm365_c14c_a_failed_skill_listing_is_not_only_here() {
+    use std::os::unix::fs::PermissionsExt;
+    let tmp = tempfile::tempdir().unwrap();
+    let occupant = tmp.path().join("occupant");
+    let skill = tmp.path().join("skill");
+    write(&occupant, &[("SKILL.md", "theirs"), ("sub/x.md", "x")]);
+    write(&skill, &[("SKILL.md", "ours"), ("sub/x.md", "x")]);
+    fs::set_permissions(skill.join("sub"), fs::Permissions::from_mode(0o000)).unwrap();
+    let readable = fs::read_dir(skill.join("sub")).is_ok();
+    let result = list_occupant_files(&occupant, Some(&skill));
+    fs::set_permissions(skill.join("sub"), fs::Permissions::from_mode(0o755)).unwrap();
+    if readable {
+        return; // running as root: the premise cannot be set up
+    }
+    match result {
+        Err(_) => {}
+        Ok(listing) => {
+            let only_here: Vec<&str> = listing
+                .entries
+                .iter()
+                .filter(|e| e.compared == FileComparison::OnlyHere)
+                .map(|e| e.path.as_str())
+                .collect();
+            assert!(only_here.is_empty(), "labelled only here: {only_here:?}");
+        }
+    }
+}
+
+/// Check 16 (backend half): a file present on one side and empty is never
+/// "same" as a missing one, and a final newline makes two files differ.
+#[test]
+fn qm365_c16_backend_labels_empty_vs_missing_and_final_newline_as_different() {
+    let tmp = tempfile::tempdir().unwrap();
+    let occupant = tmp.path().join("occupant");
+    let skill = tmp.path().join("skill");
+    write(&occupant, &[("SKILL.md", "a\n"), ("empty.md", "")]);
+    write(&skill, &[("SKILL.md", "a")]);
+
+    let entries = list_occupant_files(&occupant, Some(&skill))
+        .unwrap()
+        .entries;
+    let of = |p: &str| entries.iter().find(|e| e.path == p).unwrap().compared;
+    assert_eq!(of("SKILL.md"), FileComparison::Changed);
+    assert_eq!(of("empty.md"), FileComparison::OnlyHere);
+    let read = read_occupant_file(&occupant, Some(&skill), "empty.md").unwrap();
+    assert_eq!(read.occupant.as_deref(), Some(""));
+    assert_eq!(read.skill, None, "missing on the skill side is None");
+}
