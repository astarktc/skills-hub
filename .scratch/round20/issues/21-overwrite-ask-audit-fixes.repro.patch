+// QM-365 reproduction tests (control lane): each asserts the CORRECT
+// behaviour for one check of `repro-brief.md`, so it fails while the defect
+// is present. Real `en` copy, real folds, real fixture backend.
+import i18next from "i18next";
+import type { Channel } from "@tauri-apps/api/core";
+import { beforeAll, describe, expect, it } from "vitest";
+import type { ProjectSyncReport, RedeployProgress, RedeployReport } from "../bindings";
+import { resources } from "../i18n/resources";
+import {
+  aheadMoveRows,
+  askRowCopy,
+  askRowLabels,
+  editedCopyHints,
+  globalCollisionRows,
+  redeployAskRows,
+  type OverwriteRow,
+} from "./overwriteAsk";
+import { lineDiff } from "./skillFiles";
+import { projectSyncOutcome } from "./reportOutcome";
+import { createFixtureBackend } from "../fixtures/backend";
+import { buildScenario } from "../fixtures/scenarios";
+
+type T = (key: string, options?: Record<string, unknown>) => string;
+let t: T;
+beforeAll(async () => {
+  const i18n = i18next.createInstance();
+  await i18n.init({ resources, lng: "en", interpolation: { escapeValue: false } });
+  t = i18n.t.bind(i18n) as unknown as T;
+});
+
+const HOME = "/Users/op";
+const labels = { codex: "Codex", agents_skills: "Shared folder", mux: "Xum", windsurf: "Devin (Windsurf)", cursor: "Cursor", claude_code: "Claude Code", trae: "Trae", trae_cn: "Trae CN" };
+
+/**
+ * The first run of the Rust test `qm365_c01c…` / `a_folder_in_the_way_and_an_edited_old_copy_are_asked_in_one_ask`:
+ * Codex's move to the shared folder is held by a folder in its way, and its
+ * edited old copy is asked ahead of the move (`ahead: true`, `entry_id` the
+ * moved row's id).
+ */
+const combined = (): RedeployReport => ({
+  moves: [
+    {
+      skill_id: "alpha",
+      skill_name: "alpha",
+      folder_key: "agents_skills",
+      path: `${HOME}/.agents/skills/alpha`,
+      cause: "correction",
+      rows: [{ id: "row-codex", tool: "codex", from: `${HOME}/.codex/skills/alpha`, entry_id: null }],
+      status: {
+        status: "failed",
+        error: {
+          code: "TARGET_EXISTS",
+          path: `${HOME}/.agents/skills/alpha`,
+          modifiedAt: 1,
+          sameContent: false,
+          owner: { kind: "foreign" },
+        },
+      },
+      overwritten: false,
+    },
+  ],
+  journal: [],
+  left_behind: [],
+  edited_copies: [
+    {
+      entry_id: "row-codex",
+      ahead: true,
+      skill_id: "alpha",
+      skill_name: "alpha",
+      tool: "codex",
+      path: `${HOME}/.codex/skills/alpha`,
+      modified_at: 1,
+      readers: ["codex"],
+      duplicate_readers: ["codex"],
+    },
+  ],
+  lost_disables: [],
+  refused_answers: [],
+});
+
+describe("check 1: an edited copy asked ahead of a blocked move", () => {
+  it("(a) nothing in the ask says or implies the skill already works from its new folder", () => {
+    const rows = redeployAskRows(combined(), labels);
+    const edited = rows.find((row) => row.question === "editedCopy")!;
+    expect(edited.ahead).toBe(true);
+    const copy = askRowCopy(edited, t);
+    const text = [...editedCopyHints(rows, t), copy.provenance, copy.keep, copy.overwrite].join("\n");
+    expect(text).not.toMatch(/already works from its new folder/i);
+    expect(text).not.toMatch(/works from its new folder/i);
+  });
+
+  it("(b) the row's Delete and Leave consequences say they apply only if the move goes ahead", () => {
+    const edited = redeployAskRows(combined(), labels).find((row) => row.question === "editedCopy")!;
+    const copy = askRowCopy(edited, t);
+    expect(copy.overwrite).toMatch(/^If the move goes ahead/);
+    expect(copy.keep).toMatch(/^If the move goes ahead/);
+  });
+
+  it("(c) Keep for the destination + Delete for the copy: the ask says the copy answer does nothing now", () => {
+    const rows = redeployAskRows(combined(), labels);
+    const moveOf = aheadMoveRows(rows);
+    const index = rows.findIndex((row) => row.question === "editedCopy");
+    expect(moveOf[index]).not.toBeNull();
+    // OverwriteModal: `moveKept={moveRows[index] !== null && choices[moveRows[index]] === 'keep'}`;
+    // the row then shows `copy.voided ?? …` in place of the chosen consequence.
+    const copy = askRowCopy(rows[index], t, { moveKept: true });
+    expect(copy.voided).toMatch(/Nothing happens to this copy now/);
+  });
+});
+
+describe("check 5: accessible names of Reveal and the content-view button", () => {
+  const global = (tool: string, path: string): OverwriteRow => ({
+    skillId: "s1",
+    skillName: "alpha",
+    toolKey: tool,
+    toolLabel: labels[tool as keyof typeof labels] ?? tool,
+    path,
+    modifiedAt: null,
+    sameContent: false,
+    owner: { kind: "foreign" },
+    ownerToolLabel: null,
+    scope: { kind: "global" },
+  });
+  // The two buttons' names, exactly as OverwriteModal.tsx composes them (AskRow).
+  const names = (rows: OverwriteRow[]) => {
+    const rowLabels = askRowLabels(rows, t);
+    return {
+      reveal: rowLabels.map((label) => t("overwriteAsk.revealLabel", { label })),
+      contents: rowLabels.map((label) => `${t("overwriteAsk.showContents")}: ${label}`),
+    };
+  };
+
+  it("are distinct across rows of a redeploy ask (folder in the way + edited copy)", () => {
+    const { reveal, contents } = names(redeployAskRows(combined(), labels));
+    expect(new Set(reveal).size).toBe(reveal.length);
+    expect(new Set(contents).size).toBe(contents.length);
+  });
+
+  it("are distinct even when two rows read alike", () => {
+    const rows = [global("cursor", "/x/alpha"), global("cursor", "/x/alpha"), global("claude_code", "/y/alpha")];
+    const { reveal, contents } = names(rows);
+    expect(new Set(reveal).size).toBe(3);
+    expect(new Set(contents).size).toBe(3);
+  });
+
+  it("are distinct for a real sync report's two collision rows", () => {
+    const rows = globalCollisionRows(
+      ["cursor", "claude_code"].map((tool) => ({
+        skill_id: "s1",
+        skill_name: "alpha",
+        tool_key: tool,
+        folder_key: tool,
+        status: {
+          status: "failed" as const,
+          error: { code: "TARGET_EXISTS" as const, path: `/${tool}/alpha`, modifiedAt: 1, sameContent: false, owner: { kind: "foreign" as const } },
+        },
+      })),
+      labels,
+    );
+    const { reveal, contents } = names(rows);
+    expect(new Set(reveal).size).toBe(2);
+    expect(new Set(contents).size).toBe(2);
+  });
+});
+
+describe("check 8: 'shows twice' follows the backend's duplicate_readers", () => {
+  it("an edited copy whose backend row names Xum a duplicate reader is not asked as 'shows twice' (not a proven duplicate)", () => {
+    // What the Rust test qm365_c08a printed for the production registry:
+    // readers ["mux"], duplicate_readers ["mux"] (Xum's duplicates: Shadows).
+    const report: RedeployReport = {
+      ...combined(),
+      moves: [],
+      edited_copies: [
+        { ...combined().edited_copies[0], ahead: false, tool: "mux", path: `${HOME}/.mux/skills/alpha`, readers: ["mux"], duplicate_readers: ["mux"] },
+      ],
+    };
+    const [row] = redeployAskRows(report, labels);
+    const leave = askRowCopy(row, t).keep;
+    // Correct behaviour: no "shows twice" for an unproven duplicate.
+    expect(leave).not.toMatch(/shows twice/);
+  });
+});
+
+describe("check 10: project overwritten lines name their project path", () => {
+  it("two projects' overwritten lines (same skill, same harness) are distinct", () => {
+    const item = (project: string) => ({
+      assignment_id: `a-${project}`,
+      project_id: project,
+      skill_id: "s1",
+      skill_name: "alpha",
+      tool: "claude_code",
+      folder_key: "claude_code",
+      status: { status: "overwritten" as const, path: `/work/${project}/.claude/skills/alpha` },
+    });
+    const report: ProjectSyncReport = { items: [item("app-a"), item("app-b")], skipped_projects: [] };
+    for (const action of ["resync", "resyncAll", "bulkAssign"] as const) {
+      const out = projectSyncOutcome(report, { t, toolLabelById: labels, action });
+      expect(out.notes).toHaveLength(2);
+      expect(new Set(out.notes).size).toBe(2);
+      expect(out.toast?.detail).toContain("/work/app-a/");
+      expect(out.toast?.detail).toContain("/work/app-b/");
+    }
+  });
+});
+
+describe("check 12: a legacy project key (trae_cn on folder trae) overwritten", () => {
+  it("keeps its overwritten line and count through the fold", () => {
+    const report: ProjectSyncReport = {
+      items: [
+        {
+          assignment_id: "pa-trae_cn",
+          project_id: "p1",
+          skill_id: "s1",
+          skill_name: "trae-skill",
+          tool: "trae_cn",
+          folder_key: "trae",
+          status: { status: "overwritten", path: "/work/p1/.trae/skills/trae-skill" },
+        },
+      ],
+      skipped_projects: [],
+    };
+    for (const action of ["resync", "syncCell", "toggleOn", "bulkAssign", "resyncAll"] as const) {
+      const out = projectSyncOutcome(report, { t, toolLabelById: labels, action });
+      expect(out.notes).toEqual([t("outcome.overwrittenLine", { name: "trae-skill", tool: "Trae", path: "/work/p1/.trae/skills/trae-skill" })]);
+      expect(out.toast?.detail).toContain("/work/p1/.trae/skills/trae-skill");
+      if (action === "resync" || action === "resyncAll" || action === "bulkAssign")
+        expect(out.toast?.message).toContain(t("outcome.overwritten", { count: 1 }));
+    }
+  });
+});
+
+describe("check 15: the 'Keep all' line in a redeploy ask", () => {
+  it("does not say the skills stay off their harnesses (a kept move leaves the old Deployment in place)", () => {
+    // OverwriteModal.tsx renders `t('overwriteAsk.consequence.all')` under
+    // every per-row ask with an occupied row, redeploy asks included.
+    expect(t("overwriteAsk.consequence.all")).not.toMatch(/stays off/);
+  });
+});
+
+describe("check 16: the content view's 'same' for unequal files", () => {
+  // SkillFiles.tsx FileDiff: `if (lines.every((line) => line.kind === "same"))`
+  // shows "This file is the same as the skill's."; useSkillDocument passes
+  // `content: both.occupant ?? ""` and `skillContent: both.skill`.
+  const saysSame = (ours: string | null, theirs: string) => lineDiff(ours, theirs).every((line) => line.kind === "same");
+
+  it("one side missing, the other an empty file, is not 'same'", () => {
+    // Only in the skill (empty there), missing in the occupant: occupant null → "".
+    expect(saysSame("", "")).toBe(false);
+    // Only in the occupant (empty), missing in the skill: skill null.
+    expect(saysSame(null, "")).toBe(false);
+  });
+
+  it("files differing only by a final newline are not 'same'", () => {
+    expect(saysSame("line\n", "line")).toBe(false);
+    expect(saysSame("line", "line\n")).toBe(false);
+  });
+});
+
+describe("check 17: the fixture's registry scenario", () => {
+  it("raises an edited-copy ask row", async () => {
+    const now = 1_700_000_000_000;
+    const backend = createFixtureBackend(buildScenario("registry", now), { latencyScale: 0, now: () => now });
+    const channel = { onmessage: () => {} } as unknown as Channel<RedeployProgress>;
+    const run = await backend.handlers.redeployDeployments([], channel);
+    expect(run.report.edited_copies.length).toBeGreaterThan(0);
+  });
+});
